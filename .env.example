# Copiar a `.env` en la raíz (Docker Compose) y/o a `backend/.env.local` (dev API).

# MySQL (Compose mapea DB_* → MYSQL* del backend)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=profruit_root
DB_NAME=profruit_db

MYSQL_ROOT_PASSWORD=profruit_root
MYSQL_DATABASE=profruit_db
MYSQL_PUBLISH_PORT=3307
API_PUBLISH_PORT=3000
FRONTEND_PORT=8080

# Auth (obligatorio para login / tokens)
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio

# Frontend en Docker local; en Netlify usa la variable del panel o .env.production
REACT_APP_API_URL=http://localhost:8080
